# ---------------------------------------------------------------------------
# PaperPilot backend environment
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Google AI Studio API key -> https://aistudio.google.com/app/apikey
# Required for answering questions. Also used for embeddings when
# EMBEDDING_PROVIDER=google (the default).
GOOGLE_API_KEY=

# Chat model used to generate grounded answers.
GEMINI_MODEL=gemini-2.0-flash

# Embedding provider: "google" (API, no local download) or "local"
# ("local" runs sentence-transformers on your machine; install the optional
# dependency in requirements.txt first).
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Authentication & Security
JWT_SECRET=your-secret-key-at-least-32-chars-long
USERS_DB_PATH=./data/users.db

# Where data lives on disk (relative paths are resolved from backend/).
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
REGISTRY_PATH=./data/documents.json

# Ingestion + retrieval tuning
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
MAX_DISTANCE=0.85

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
